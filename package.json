{
  "name": "dart-method-generator",
  "displayName": "Dart Method Generator",
  "description": "Generate common methods for Dart classes including constructor, copyWith, serialization and equality methods",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:dart-method-generator.generateMethods"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dart-method-generator.generateMethods",
        "title": "Generate Dart Methods"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dart-method-generator.generateMethods",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^16.11.6",
    "typescript": "^4.5.4"
  },
  "dependencies": {
    "vscode": "^1.1.37"
  }
}
